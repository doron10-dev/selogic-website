{
  "name": "selogic-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "qa": "node scripts/qa-smoke.mjs",
    "qa:types": "tsc --noEmit",
    "qa:all": "npm run qa:types && npm run qa",
    "brand:webp": "node scripts/optimize-brand-images.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "next": "15.3.9",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "resend": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "sharp": "^0.34.3",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3"
  }
}
