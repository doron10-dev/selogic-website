# Public site URL — required for sitemap, robots, and Open Graph in production.
# Example: https://selogic.co.il
NEXT_PUBLIC_SITE_URL=

# Form submission gate — set true only after Resend domain is verified and all mail vars are set.
FORMS_ENABLED=false

# Resend (server only — never expose to client)
RESEND_API_KEY=

# Verified sender on selogic.co.il (Resend domain verification required)
MAIL_FROM=forms@selogic.co.il

# Production: info@selogic.co.il | Preview: dev+forms@selogic.co.il (or personal test inbox)
MAIL_TO=info@selogic.co.il

# --- Local activation checklist ---
# 1. Copy this file to .env.local
# 2. Set NEXT_PUBLIC_SITE_URL (production domain or http://localhost:3000 for local tests)
# 3. Verify selogic.co.il in Resend and add RESEND_API_KEY
# 4. Set FORMS_ENABLED=true
# 5. Restart dev server and confirm GET /api/forms/status returns {"enabled":true}
